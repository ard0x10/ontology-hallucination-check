    uni:locatedIn uni:Ankara ;
    uni:hasFaculty uni:F_Muh, uni:F_FenEd, uni:F_Mim, uni:F_Iibf, uni:F_Egitim ;
    uni:website "https://www.metu.edu.tr"^^xsd:anyURI .

