@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix uni:  <http://example.org/tr-uni#> .

#####################################################################
# T-BOX: Sınıflar ve Özellikler (Ontoloji şeması)
#####################################################################

uni:University    a owl:Class ; rdfs:label "Üniversite"@tr .
uni:PublicUniversity      a owl:Class ; rdfs:subClassOf uni:University ;
    rdfs:label "Devlet Üniversitesi"@tr .
uni:FoundationUniversity  a owl:Class ; rdfs:subClassOf uni:University ;
    rdfs:label "Vakıf Üniversitesi"@tr .

uni:City        a owl:Class ; rdfs:label "Şehir"@tr .
uni:Faculty     a owl:Class ; rdfs:label "Fakülte"@tr .

uni:foundedYear     a owl:DatatypeProperty ;
    rdfs:domain uni:University ; rdfs:range xsd:integer ;
    rdfs:label "Kuruluş Yılı"@tr .

uni:locatedIn       a owl:ObjectProperty ;
    rdfs:domain uni:University ; rdfs:range uni:City ;
    rdfs:label "Bulunduğu Şehir"@tr .

uni:hasFaculty      a owl:ObjectProperty ;
    rdfs:domain uni:University ; rdfs:range uni:Faculty ;
    rdfs:label "Fakülteleri"@tr .

uni:officialName    a owl:DatatypeProperty ;
    rdfs:domain uni:University ; rdfs:range xsd:string ;
    rdfs:label "Resmi Ad"@tr .

uni:website         a owl:DatatypeProperty ;
    rdfs:domain uni:University ; rdfs:range xsd:anyURI ;
    rdfs:label "Web Sitesi"@tr .

#####################################################################
# Şehirler
#####################################################################
uni:Istanbul  a uni:City ; rdfs:label "İstanbul"@tr .
uni:Ankara    a uni:City ; rdfs:label "Ankara"@tr .
uni:Izmir     a uni:City ; rdfs:label "İzmir"@tr .
uni:Erzurum   a uni:City ; rdfs:label "Erzurum"@tr .
uni:Trabzon   a uni:City ; rdfs:label "Trabzon"@tr .
uni:Eskisehir a uni:City ; rdfs:label "Eskişehir"@tr .
uni:Konya     a uni:City ; rdfs:label "Konya"@tr .
uni:Bursa     a uni:City ; rdfs:label "Bursa"@tr .

#####################################################################
# Fakülteler (örnek küçük küme)
#####################################################################
uni:F_Muh   a uni:Faculty ; rdfs:label "Mühendislik Fakültesi"@tr .
uni:F_Tip   a uni:Faculty ; rdfs:label "Tıp Fakültesi"@tr .
uni:F_Hukuk a uni:Faculty ; rdfs:label "Hukuk Fakültesi"@tr .
uni:F_FenEd a uni:Faculty ; rdfs:label "Fen-Edebiyat Fakültesi"@tr .
uni:F_Iibf  a uni:Faculty ; rdfs:label "İktisadi ve İdari Bilimler Fakültesi"@tr .
uni:F_Mim   a uni:Faculty ; rdfs:label "Mimarlık Fakültesi"@tr .
uni:F_Egitim a uni:Faculty ; rdfs:label "Eğitim Fakültesi"@tr .
uni:F_Iletisim a uni:Faculty ; rdfs:label "İletişim Fakültesi"@tr .

#####################################################################
# A-BOX: Bireyler (Üniversiteler — doğrulanmış gerçekler)
#####################################################################

uni:Bogazici a uni:PublicUniversity ;
    rdfs:label "Boğaziçi Üniversitesi"@tr ;
    uni:officialName "Boğaziçi Üniversitesi" ;
    uni:foundedYear 1863 ;
    uni:locatedIn uni:Istanbul ;
    uni:hasFaculty uni:F_Muh, uni:F_FenEd, uni:F_Egitim, uni:F_Iibf ;
    uni:website "https://www.boun.edu.tr"^^xsd:anyURI .

uni:ITU a uni:PublicUniversity ;
    rdfs:label "İstanbul Teknik Üniversitesi"@tr ;
    uni:officialName "İstanbul Teknik Üniversitesi" ;
    uni:foundedYear 1773 ;
    uni:locatedIn uni:Istanbul ;
    uni:hasFaculty uni:F_Muh, uni:F_Mim ;
    uni:website "https://www.itu.edu.tr"^^xsd:anyURI .

